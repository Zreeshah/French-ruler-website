---
import BaseLayout from '../layouts/BaseLayout.astro';

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://regle-enligne.onl/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Contact",
      "item": "https://regle-enligne.onl/contact/"
    }
  ]
});
---

<BaseLayout
  title="Contact – Regle-Enligne.onl"
  description="Contactez l'équipe de Regle-Enligne.onl pour signaler une erreur de mesure, une page imprécise ou proposer une amélioration de la règle en ligne."
  canonicalUrl="https://regle-enligne.onl/contact/"
  schemaMarkup={breadcrumbSchema}
>
  <section class="section privacy-page">
    <div class="container privacy-container">
      <nav class="breadcrumb" aria-label="Fil d'Ariane">
        <ol>
          <li><a href="/">Règle en ligne</a></li>
          <li aria-current="page">Contact</li>
        </ol>
      </nav>

      <h1>Contact</h1>

      <div class="privacy-content">
        <p>
          Vous pouvez nous écrire à
          <a href="mailto:contact@regle-enligne.onl">contact@regle-enligne.onl</a>.
          Nous répondons en général sous 48 heures ouvrées. Vous pouvez aussi
          signaler un problème sur notre
          <a href="https://github.com/Zreeshah/French-ruler-website/issues" rel="noopener noreferrer">espace de retours</a>,
          sans indiquer d'adresse e-mail.
        </p>

        <h2>Écrire un message</h2>
        <p>
          Remplissez le formulaire : il ouvre votre messagerie avec l'adresse,
          l'objet et le message déjà remplis. Aucune donnée n'est envoyée par
          le site lui-même — le message part depuis votre propre messagerie.
        </p>

        <form class="contact-form" id="contact-form">
          <label for="contact-nom">Votre nom</label>
          <input id="contact-nom" name="nom" type="text" autocomplete="name" required />

          <label for="contact-email">Votre adresse e-mail</label>
          <input id="contact-email" name="email" type="email" autocomplete="email" required />

          <label for="contact-sujet">Sujet</label>
          <select id="contact-sujet" name="sujet">
            <option value="Erreur de mesure ou de calibrage">Erreur de mesure ou de calibrage</option>
            <option value="Erreur dans un guide ou un tableau">Erreur dans un guide ou un tableau</option>
            <option value="Page qui ne s'affiche pas correctement">Page qui ne s'affiche pas correctement</option>
            <option value="Suggestion d'amélioration">Suggestion d'amélioration</option>
            <option value="Question sur la confidentialité">Question sur la confidentialité</option>
            <option value="Autre question">Autre question</option>
          </select>

          <label for="contact-message">Votre message</label>
          <textarea id="contact-message" name="message" rows="6" required></textarea>

          <button type="submit" class="btn btn-primary">Envoyer par e-mail</button>
          <p class="contact-form-note">Le bouton ouvre votre application de messagerie : vérifiez le message, puis envoyez-le.</p>
        </form>

        <h2>Que faut-il indiquer dans votre message ?</h2>
        <p>
          Pour que nous puissions reproduire le problème et le corriger, indiquez
          la page concernée, votre appareil (téléphone, tablette ou ordinateur),
          votre navigateur, et ce que vous avez mesuré. Par exemple : « Sur la page
          de la règle à imprimer, la zone de contrôle mesure 4,8 cm au lieu de 5 cm,
          sur un ordinateur portable avec le navigateur Firefox. » Plus votre
          message est précis, plus la correction est rapide.
        </p>

        <h2>Que pouvez-vous nous signaler ?</h2>
        <ul class="privacy-list">
          <li>Une mesure qui semble fausse ou un calibrage qui ne fonctionne pas</li>
          <li>Une erreur dans un guide ou dans un tableau de conversion</li>
          <li>Une page qui ne s'affiche pas correctement sur votre appareil</li>
          <li>Une suggestion d'amélioration ou un nouveau guide à écrire</li>
          <li>Une question sur la confidentialité — voir aussi la <a href="/politique-de-confidentialite/">politique de confidentialité</a></li>
        </ul>

        <h2>Délai de réponse</h2>
        <p>
          Nous répondons en général sous 48 heures ouvrées. Chaque signalement
          d'erreur est examiné : si une correction est nécessaire, le guide ou
          l'outil est corrigé et la date de mise à jour est indiquée sur la page.
        </p>

        <h2>Avant de nous écrire</h2>
        <p>
          La plupart des mesures fausses viennent du calibrage ou du zoom. Avant de
          signaler une erreur, vérifiez que le zoom de votre navigateur est à 100 %,
          refaites le calibrage avec une carte bancaire de 85,6 mm et mesurez une
          deuxième fois. Le guide <a href="/blog/calibrage-regle-en-ligne/">Calibrage
          de la règle en ligne</a> explique chaque étape. Pour en savoir plus sur
          le site et son exploitante, lisez la page <a href="/a-propos/">À propos</a>
          et les <a href="/mentions-legales/">mentions légales</a>.
        </p>

        <div class="privacy-cta">
          <a href="/" class="btn btn-primary">Retour à la règle en ligne</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Le formulaire compose un e-mail vers contact@regle-enligne.onl
  // et l'ouvre dans la messagerie de l'utilisateur. Aucun envoi serveur.
  document.getElementById('contact-form')?.addEventListener('submit', (event) => {
    event.preventDefault();
    const nom = (document.getElementById('contact-nom') as HTMLInputElement).value.trim();
    const email = (document.getElementById('contact-email') as HTMLInputElement).value.trim();
    const sujet = (document.getElementById('contact-sujet') as HTMLSelectElement).value;
    const message = (document.getElementById('contact-message') as HTMLTextAreaElement).value.trim();
    const corps = `Nom : ${nom}\nAdresse e-mail : ${email}\n\n${message}`;
    window.location.href =
      'mailto:contact@regle-enligne.onl' +
      '?subject=' + encodeURIComponent('[Regle-Enligne.onl] ' + sujet) +
      '&body=' + encodeURIComponent(corps);
  });
</script>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .contact-form label {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-top: var(--space-3);
  }

  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    width: 100%;
    padding: var(--space-3);
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-md);
    font: inherit;
    font-size: 0.9375rem;
    color: var(--text-primary);
    background: var(--bg-primary);
  }

  .contact-form button {
    margin-top: var(--space-4);
    align-self: flex-start;
  }

  .contact-form-note {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    margin-bottom: 0;
  }
  .privacy-container {
    max-width: var(--container-lg);
  }

  .breadcrumb ol {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    margin-bottom: var(--space-6);
  }

  .breadcrumb li:not(:last-child)::after {
    content: '›';
    margin-left: var(--space-2);
    color: var(--border-dark);
  }

  .breadcrumb a {
    color: var(--text-tertiary);
  }

  .breadcrumb a:hover {
    color: var(--accent);
  }

  .privacy-content h2 {
    margin-top: var(--space-8);
  }

  .privacy-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
    padding-left: var(--space-5);
  }

  .privacy-list li {
    list-style: disc;
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .privacy-cta {
    margin-top: var(--space-10);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border);
  }
</style>
