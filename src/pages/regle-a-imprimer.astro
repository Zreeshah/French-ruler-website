---
import BaseLayout from '../layouts/BaseLayout.astro';

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://regle-enligne.onl/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Règle à imprimer",
      "item": "https://regle-enligne.onl/regle-a-imprimer/"
    }
  ]
});

const rulerSizes = [10, 20, 30];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "La règle imprimée est-elle exacte ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Oui, si vous imprimez à l'échelle 100 % sur une feuille A4 et que la zone de contrôle mesure exactement 5 cm après impression. Si la zone est plus courte ou plus longue, la règle ne sera pas exacte : vérifiez l'échelle et les marges, puis imprimez de nouveau." }
    },
    {
      "@type": "Question",
      "name": "Quel papier utiliser pour imprimer une règle ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Une feuille A4 ordinaire suffit pour une mesure d'appoint. Pour une règle qui doit durer, choisissez un papier épais, de 160 g/m² ou plus, ou collez la feuille imprimée sur un carton fin et découpez-la proprement." }
    },
    {
      "@type": "Question",
      "name": "Puis-je imprimer la règle en noir et blanc ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Oui. Les graduations sont en noir et restent parfaitement lisibles en noir et blanc. La couleur n'apporte rien à la précision de la mesure." }
    },
    {
      "@type": "Question",
      "name": "Pourquoi ma zone de contrôle ne fait-elle pas 5 cm ?",
      "acceptedAnswer": { "@type": "Answer", "text": "L'imprimante ou le navigateur a presque toujours réduit le document, par exemple avec l'option « Ajuster à la page ». Réglez l'échelle sur 100 %, désactivez toute adaptation à la page, vérifiez que le zoom du navigateur est à 100 % et imprimez de nouveau." }
    },
    {
      "@type": "Question",
      "name": "Puis-je utiliser la règle imprimée pour mesurer un écran ?",
      "acceptedAnswer": { "@type": "Answer", "text": "Oui, pour une estimation rapide de la largeur ou de la hauteur d'un écran. Pour la diagonale en pouces, le guide sur la mesure d'un écran en pouces est plus précis, car il explique la conversion entre centimètres et pouces." }
    }
  ]
});

const schemaMarkup = JSON.stringify([JSON.parse(breadcrumbSchema), JSON.parse(faqSchema)]);
---

<BaseLayout
  title="Règle à imprimer – Règle en cm de 10 cm, 20 cm et 30 cm"
  description="Imprimez une règle en ligne gratuite en centimètres et millimètres. Règle à imprimer A4 avec échelle à 100%."
  canonicalUrl="https://regle-enligne.onl/regle-a-imprimer/"
  schemaMarkup={schemaMarkup}
>
  <section class="section print-hero">
    <div class="container">
      <!-- Breadcrumb -->
      <nav class="breadcrumb no-print" aria-label="Fil d'Ariane">
        <ol>
          <li><a href="/">Règle en ligne</a></li>
          <li aria-current="page">Règle à imprimer</li>
        </ol>
      </nav>

      <h1>Règle à imprimer</h1>
      <p class="page-intro">
        Besoin d'une règle physique ? Imprimez notre règle graduée en centimètres et millimètres. 
        Pour conserver la bonne échelle, réglez l'impression à <strong>100%</strong>.
      </p>
    </div>
  </section>

  <!-- Print Instructions -->
  <section class="section section-alt print-instructions no-print">
    <div class="container">
      <h2>Comment imprimer correctement la règle</h2>
      <ol class="instruction-steps">
        <li>
          <span class="step-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
          </span>
          <span>Sélectionnez l'option d'impression (Ctrl+P ou le bouton ci-dessous).</span>
        </li>
        <li>
          <span class="step-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
          </span>
          <span>Réglez l'échelle sur <strong>100%</strong>.</span>
        </li>
        <li>
          <span class="step-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </span>
          <span>Désactivez l'option <strong>"Ajuster à la page"</strong>.</span>
        </li>
        <li>
          <span class="step-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </span>
          <span>Après impression, vérifiez la <strong>zone de contrôle de 5 cm</strong> ci-dessous.</span>
        </li>
        <li>
          <span class="step-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 4v6h6"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
          </span>
          <span>Si la zone ne fait pas exactement 5 cm, imprimez à nouveau avec d'autres paramètres.</span>
        </li>
      </ol>

      <div class="notice notice-warning" style="margin-top: var(--space-6);">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
          <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        <span><strong>Important :</strong> N'ajustez pas à la page. Imprimez à l'échelle 100%, sinon la règle ne sera pas exacte.</span>
      </div>

      <!-- Buttons -->
      <div class="print-actions">
        <button class="btn btn-primary btn-lg" id="btn-print" aria-label="Imprimer la règle">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
          Imprimer la règle
        </button>
        <button class="btn btn-secondary btn-lg" id="btn-download-pdf" aria-label="Télécharger le PDF">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Télécharger le PDF
        </button>
        <a href="/" class="btn btn-secondary btn-lg">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          Retour à la règle en ligne
        </a>
      </div>
    </div>
  </section>

  <!-- Guide : imprimer une règle exacte -->
  <section class="section no-print">
    <div class="container">
      <h2>Pourquoi imprimer une règle à l'échelle 100 %</h2>
      <p>
        Une règle n'a de valeur que si ses centimètres sont vrais. Sur un écran, un centimètre dépend du
        calibrage ; sur le papier, il dépend de l'imprimante. La plupart des imprimantes et des navigateurs
        réduisent le document par défaut pour qu'il « tienne » dans la page, avec des options comme
        « Ajuster à la page » ou « Adapter à la page ». Une réduction de seulement 5 % transforme un
        centimètre en 9,5 millimètres, et l'erreur grandit avec la distance : sur 30 cm, elle atteint
        déjà 1,5 cm. C'est pour cela que cette page insiste sur l'échelle 100 % et qu'elle fournit une
        zone de contrôle de 5 cm : c'est la preuve, après impression, que votre règle est exacte.
        Si la zone de contrôle mesure exactement 5 cm avec une règle physique, vous pouvez faire
        confiance à toutes les graduations de la page. Si elle mesure 4,8 cm ou 5,2 cm, ne corrigez
        pas à l'œil : changez les réglages et imprimez de nouveau.
      </p>
      <p>
        Le principe est le même que pour le calibrage de la <a href="/">règle en ligne</a> : sans
        référence physique, aucune mesure à l'écran ou sur papier n'est fiable. La carte bancaire,
        large de 85,6 mm, sert de référence pour la règle à l'écran ; la zone de contrôle de 5 cm
        joue ce rôle pour la règle imprimée. Pour comprendre le calibrage en détail, lisez le guide
        <a href="/blog/calibrage-regle-en-ligne/">Calibrage de la règle en ligne</a>.
      </p>

      <h2>Choisir le bon format : 10, 20 ou 30 cm</h2>
      <p>
        Cette page propose trois règles, de 10, 20 et 30 cm, parce qu'aucune longueur ne convient
        à tous les usages. La règle de 10 cm tient dans une poche ou un sac : elle sert à mesurer
        une bague, une vis, une pile, une carte SIM ou l'étiquette d'un colis. La règle de 20 cm
        convient aux livres, aux cahiers, aux feuilles et aux petits objets du quotidien. La règle
        de 30 cm couvre toute la longueur d'une feuille A4 : elle sert pour un dessin, un patron,
        un avant-bras ou un objet long et plat. Choisissez toujours la règle la plus courte qui
        couvre votre objet : plus la mesure est proche du zéro, plus elle est précise, car
        l'erreur d'impression, si elle existe, s'accumule avec la distance.
      </p>
      <p>
        Le format de papier compte autant que la longueur de la règle. Les trois règles sont
        prévues pour une feuille A4, le format standard en France et en Europe. Si votre
        imprimante est réglée sur le format Lettre américain, la mise en page change et l'échelle
        peut être faussée. Le guide <a href="/blog/formats-papier-a4-a3-a5/">Formats de papier
        A4, A3 et A5</a> explique les dimensions exactes de chaque format et comment les
        reconnaître avant d'imprimer.
      </p>

      <h2>Réglages d'impression sur A4</h2>
      <p>
        Avant d'imprimer, vérifiez quatre réglages. D'abord, le format de papier : A4, en
        orientation portrait. Ensuite, les marges : choisissez les marges minimales proposées par
        votre imprimante, sans activer l'option qui réduit le document pour les respecter.
        Troisièmement, l'échelle : 100 %, « taille réelle » ou « échelle réelle », selon le
        navigateur. Enfin, la couleur : le noir et blanc suffit amplement, les graduations sont
        en noir et restent parfaitement lisibles. Un papier épais, de 160 g/m² ou plus, donne
        une règle plus rigide et plus durable ; une feuille ordinaire suffit pour une mesure
        d'appoint. Pour une règle qui doit durer, collez la feuille imprimée sur un carton fin
        et découpez-la proprement le long des bords, sans couper les graduations.
      </p>

      <h2>Vérifier la règle après impression</h2>
      <p>
        La vérification prend moins d'une minute et elle est indispensable. Posez une règle
        physique sur la zone de contrôle et mesurez-la : elle doit faire exactement 5 cm, du
        début à la fin du trait. Vérifiez ensuite deux autres repères, par exemple le zéro et
        la graduation de 10 cm, puis le zéro et celle de 20 cm sur la grande règle. Si l'écart
        grandit avec la distance, l'échelle est fausse : c'est le signe d'une réduction
        automatique. Vérifiez alors que le zoom de votre navigateur est bien à 100 % avant
        d'imprimer, car un zoom de 90 % ou de 110 % dans la fenêtre d'impression fausse
        l'échelle de la même façon. Si vous imprimez depuis un téléphone, préférez un
        ordinateur : les applications mobiles d'impression appliquent souvent leur propre
        mise en page sans prévenir.
      </p>

      <h2>Erreurs fréquentes</h2>
      <p>
        L'erreur la plus fréquente est d'imprimer depuis un téléphone avec une mise à l'échelle
        automatique. La deuxième est d'utiliser un lecteur de PDF qui réduit le document pour
        l'adapter à la page : dans ce cas, enregistrez la règle avec le bouton « Télécharger
        le PDF » puis imprimez le fichier depuis un lecteur qui propose l'échelle 100 %.
        La troisième est d'imprimer sur du papier Lettre au lieu d'A4, ce qui change la mise
        en page. La quatrième est de mesurer sur une feuille pliée, humide ou gondolée :
        une feuille qui n'est pas parfaitement plane fausse la lecture, surtout aux
        extrémités. Enfin, ne mesurez jamais un objet en le posant sur la règle imprimée
        si l'objet est lourd ou coupant : la feuille se déforme et la mesure change.
      </p>

      <h2>Quand la règle imprimée ne suffit pas</h2>
      <p>
        Une règle imprimée est un outil d'appoint, pas un instrument de précision. Pour une
        petite mesure rapide, elle suffit largement. Pour une bague, une vis ou un écran,
        préférez la <a href="/">règle en ligne calibrée</a> ou une règle physique, et lisez
        le guide <a href="/blog/regle-en-ligne-precise/">Règle en ligne précise</a> pour
        connaître les limites de chaque méthode. Pour une mesure qui engage une décision
        importante — une découpe, une commande sur mesure, un montage — confirmez toujours
        avec un instrument physique : une règle en métal, un mètre ruban ou un pied à
        coulisse. Si vous mesurez souvent sur votre téléphone, le guide
        <a href="/blog/mesure-sur-telephone/">Mesurer sur téléphone</a> explique comment
        calibrer l'écran et poser le téléphone à plat pour une lecture fiable.
      </p>
      <p>
        <strong>À retenir :</strong> échelle 100 %, feuille A4, zone de contrôle de 5 cm
        vérifiée après impression, et confirmation physique pour toute mesure importante.
        Avec ces quatre réflexes, une règle imprimée gratuitement devient un outil
        honnête et utile.
      </p>
    </div>
  </section>

  <!-- Calibration Test Box -->
  <section class="section print-calibration" id="test-box">
    <div class="container">
      <h2 class="no-print">Zone de contrôle de 5 cm</h2>
      <p class="no-print">Après impression, mesurez cette zone avec une règle physique — elle doit faire exactement 5&nbsp;cm.</p>
      
      <div class="test-box-container">
        <div class="test-box" aria-label="Zone de contrôle de 5 centimètres">
          <span class="test-box-label">← 5 cm →</span>
        </div>
        <p class="test-box-note print-only">La zone ci-dessus doit faire exactement 5 cm. Si ce n'est pas le cas, imprimez à nouveau à l'échelle 100%.</p>
      </div>
    </div>
  </section>

  <!-- Printable Rulers -->
  <section class="section printable-rulers" id="regles-imprimables">
    <div class="container">
      <h2 class="no-print">Règles à imprimer</h2>
      
      {rulerSizes.map((size) => (
        <div class="print-ruler-block" id={`ruler-${size}cm`}>
          <h3 class="print-ruler-title">Règle de {size} cm</h3>
          <div class="print-ruler-svg" data-length={size}>
            <!-- La règle en SVG sera générée côté client pour l'écran, et aussi intégrée statiquement pour l'impression -->
          </div>
        </div>
      ))}

      <!-- Print-only footer -->
      <div class="print-footer print-only">
        <p>regle-enligne.onl — Règle à imprimer en centimètres et millimètres</p>
        <p>Imprimer à l'échelle 100%. N'ajustez pas à la page.</p>
      </div>
    </div>
  </section>

  <!-- Preview image -->
  <section class="section section-alt no-print">
    <div class="container" style="text-align: center;">
      <img
        src="/images/printable-preview.webp"
        alt="Règle à imprimer sur feuille A4"
        width="1024"
        height="1024"
        loading="lazy"
        style="border-radius: var(--radius-lg); margin: 0 auto; box-shadow: var(--shadow-md);"
      />
      <p style="margin-top: var(--space-4); font-size: 0.875rem; color: var(--text-tertiary);">
        Aperçu de la règle à imprimer sur feuille A4
      </p>
    </div>
  </section>
  <!-- FAQ -->
  <section class="section no-print">
    <div class="container">
      <h2>Questions fréquentes sur la règle à imprimer</h2>
      <h3>La règle imprimée est-elle exacte ?</h3>
      <p>Oui, si vous imprimez à l'échelle 100 % sur une feuille A4 et que la zone de contrôle mesure exactement 5 cm après impression. Si la zone est plus courte ou plus longue, la règle ne sera pas exacte : vérifiez l'échelle et les marges, puis imprimez de nouveau.</p>
      <h3>Quel papier utiliser pour imprimer une règle ?</h3>
      <p>Une feuille A4 ordinaire suffit pour une mesure d'appoint. Pour une règle qui doit durer, choisissez un papier épais, de 160 g/m² ou plus, ou collez la feuille imprimée sur un carton fin et découpez-la proprement.</p>
      <h3>Puis-je imprimer la règle en noir et blanc ?</h3>
      <p>Oui. Les graduations sont en noir et restent parfaitement lisibles en noir et blanc. La couleur n'apporte rien à la précision de la mesure.</p>
      <h3>Pourquoi ma zone de contrôle ne fait-elle pas 5 cm ?</h3>
      <p>L'imprimante ou le navigateur a presque toujours réduit le document, par exemple avec l'option « Ajuster à la page ». Réglez l'échelle sur 100 %, désactivez toute adaptation à la page, vérifiez que le zoom du navigateur est à 100 % et imprimez de nouveau.</p>
      <h3>Puis-je utiliser la règle imprimée pour mesurer un écran ?</h3>
      <p>Oui, pour une estimation rapide de la largeur ou de la hauteur d'un écran. Pour la diagonale en pouces, le guide sur la mesure d'un écran en pouces est plus précis, car il explique la conversion entre centimètres et pouces.</p>

      <h2>À retenir</h2>
      <ul>
        <li>Imprimez toujours à l'échelle 100 %, sur une feuille A4, sans « Ajuster à la page ».</li>
        <li>Vérifiez la zone de contrôle de 5 cm avec une règle physique après chaque impression.</li>
        <li>Choisissez la règle la plus courte qui couvre votre objet : 10, 20 ou 30 cm.</li>
        <li>Confirmez toute mesure importante avec un instrument physique.</li>
      </ul>
      <p>
        Pour mesurer directement à l'écran, utilisez la <a href="/">règle en ligne</a> et son
        guide de <a href="/blog/calibrage-regle-en-ligne/">calibrage</a>. Pour les formats
        de papier, lisez <a href="/blog/formats-papier-a4-a3-a5/">Formats de papier A4, A3
        et A5</a>, et pour les limites de précision, <a href="/blog/regle-en-ligne-precise/">Règle
        en ligne précise</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* --- Breadcrumb --- */
  .breadcrumb ol {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    margin-bottom: var(--space-6);
  }

  .breadcrumb li:not(:last-child)::after {
    content: '›';
    margin-left: var(--space-2);
    color: var(--border-dark);
  }

  .breadcrumb a {
    color: var(--text-tertiary);
  }

  .breadcrumb a:hover {
    color: var(--accent);
  }

  /* --- Page Intro --- */
  .page-intro {
    font-size: 1.125rem;
    max-width: 65ch;
  }

  /* --- Instructions --- */
  .instruction-steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
    counter-reset: step;
  }

  .instruction-steps li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .step-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: var(--accent-bg);
    border-radius: 50%;
    flex-shrink: 0;
    color: var(--accent);
  }

  /* --- Print Actions --- */
  .print-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  /* --- Test Box --- */
  .test-box-container {
    margin-top: var(--space-4);
  }

  .test-box {
    /* 5 cm à 96 ppp = 5 × 37,795 ≈ 189 px */
    width: 189px;
    height: 60px;
    border: 2px solid #000;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
  }

  .test-box-label {
    font-size: 0.875rem;
    font-weight: 700;
    color: #000;
    font-family: var(--font-mono);
  }

  .test-box-note {
    margin-top: var(--space-2);
    font-size: 0.8125rem;
    color: #000;
  }

  /* --- Print Rulers --- */
  .print-ruler-block {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .print-ruler-block:first-of-type {
    border-top: none;
  }

  .print-ruler-title {
    margin-top: 0;
    margin-bottom: var(--space-4);
    font-size: 1.125rem;
  }

  .print-ruler-svg {
    overflow-x: auto;
    padding: var(--space-2) 0;
    -webkit-overflow-scrolling: touch;
  }

  .print-ruler-svg :global(svg) {
    display: block;
  }

  /* --- Print Footer --- */
  .print-footer {
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid #000;
    text-align: center;
  }

  .print-footer p {
    font-size: 0.75rem;
    color: #000;
    margin-bottom: var(--space-1);
  }

  /* --- Print-specific overrides --- */
  @media print {
    .print-hero {
      padding: 0;
    }

    .print-hero h1 {
      font-size: 1.25rem;
      margin-bottom: var(--space-2);
    }

    .print-hero .page-intro {
      font-size: 0.875rem;
      margin-bottom: var(--space-4);
    }

    .print-calibration {
      padding: var(--space-4) 0;
    }

    .printable-rulers {
      padding: 0;
    }

    .print-ruler-block {
      page-break-inside: avoid;
      margin-top: var(--space-4);
      padding-top: var(--space-2);
      border-top: 1px solid #ccc;
    }

    .print-ruler-title {
      font-size: 0.875rem;
      margin-bottom: var(--space-2);
    }

    .print-ruler-svg {
      overflow: visible;
      padding: 0;
    }
  }
</style>

<script>
  import { generatePrintRulerSVG } from '../scripts/ruler';

  // Generate print rulers on page load
  document.querySelectorAll('.print-ruler-svg').forEach((el) => {
    const length = parseInt((el as HTMLElement).dataset.length || '10');
    el.innerHTML = generatePrintRulerSVG(length);
  });

  // Print button
  document.getElementById('btn-print')?.addEventListener('click', () => {
    window.print();
  });

  // Download PDF (triggers print dialog where user can save as PDF)
  document.getElementById('btn-download-pdf')?.addEventListener('click', () => {
    window.print();
  });
</script>
